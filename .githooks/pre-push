#!/bin/sh
#
# pre-push：推送前依次运行文档系统全部门禁与 CI 同款 ./gradlew ktlintFormat。
#
# 两段检查都只在推送时执行，提交时不走：pre-commit 只跑 ktlintFormat（原因见该脚本），
# 文档门禁若压在提交上，会挡住改动进行中的中间状态。
#
# 第一段 pnpm run verify-all：
#   - 门禁在 CI 的 pr-build-check.yml 的 docs job 里同样运行，本地提前拦截可避免推送后才暴露。
#   - 该工作流只听 pull_request，直接推送分支不产生任何检查记录，因此推送是本地唯一的自动拦截点。
#   - 门禁里包含未通过状态（如重复代码基线），此时整条推送被拒；急用可 git push --no-verify。
#
# 第二段 ./gradlew ktlintFormat：
#   - update.yml 在 push 到 main 后执行同一目标，不可自动修复的违规会中断整条语义化发版流程
#     （版本号不回写、tag 不打，见 run 34847149469），故在此提前拦截。
#   - 可自动修复的违规会静默改写文件且退出码为 0；此处若仍有差异，则说明工作区有未提交的
#     格式化结果，仅提示并中断推送，以免推送内容与工作区不一致。
#
# 与 pre-commit 的区别：pre-commit 只校验暂存区，pre-push 校验工作区全量源码，
# 因此能兜住 amend 遗漏、分支合并、以及 hook 启用前已存在的提交。

set -e

if ! command -v pnpm > /dev/null 2>&1; then
  echo ""
  echo "[pre-push] ✗ 找不到 pnpm，无法运行文档系统门禁。"
  echo "          先安装 pnpm 并执行 pnpm install，详见 Docs/构建与验证.md。"
  exit 1
fi

if [ ! -d node_modules ]; then
  echo ""
  echo "[pre-push] ✗ 缺少 node_modules，无法运行文档系统门禁。"
  echo "          先执行 pnpm install，详见 Docs/构建与验证.md。"
  exit 1
fi

echo "[pre-push] 运行文档系统门禁 ..."

if ! pnpm run verify-all; then
  echo ""
  echo "[pre-push] ✗ 文档系统门禁失败：存在不合规的文档、Agent Note 或超出基线的代码重复。"
  echo "          修正后重新推送（各门禁失败时会打印其规则页路径）。"
  echo "          如需紧急推送，可用 git push --no-verify 绕过（不推荐）。"
  exit 1
fi

echo "[pre-push] ✓ 文档系统门禁通过"

echo "[pre-push] 运行 ktlintFormat ..."

# 记录全部受版本控制的 Kotlin 文件的内容哈希
snapshot=$(mktemp)
trap 'rm -f "$snapshot"' EXIT
git ls-files -z -- '*.kt' '*.kts' |
  while IFS= read -r -d '' f; do
    [ -f "$f" ] && printf '%s  %s\n' "$(git hash-object "$f")" "$f"
  done > "$snapshot"

if ! ./gradlew ktlintFormat --console=plain -q; then
  echo ""
  echo "[pre-push] ✗ ktlintFormat 失败：存在无法自动修复的 ktlint 违规。"
  echo "          推送后 CI 的 update.yml 会在同一步骤失败并中断发版。"
  echo "          请修正后重新推送（详见各模块 build/reports/ktlint/ 下的报告）。"
  echo "          如需紧急推送，可用 git push --no-verify 绕过（不推荐）。"
  exit 1
fi

changed=""
while IFS= read -r line; do
  old=$(printf '%s\n' "$line" | cut -d' ' -f1)
  f=$(printf '%s\n' "$line" | cut -d' ' -f3-)
  [ -f "$f" ] || continue
  if [ "$old" != "$(git hash-object "$f")" ]; then
    changed="$changed  $f\n"
  fi
done < "$snapshot"

if [ -n "$changed" ]; then
  echo ""
  echo "[pre-push] ✗ ktlintFormat 改写了以下文件，且结果尚未提交："
  printf "$changed"
  echo "          请 git add 并提交后再推送，否则推送内容与工作区不一致、CI 仍可能失败。"
  exit 1
fi

echo "[pre-push] ✓ ktlintFormat 通过"
