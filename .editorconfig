root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = off
ktlint_code_style = ktlint_official
# @Composable 函数按 Jetpack Compose 惯例首字母大写，豁免函数命名规则
ktlint_standard_function-naming = disabled
# 下划线前缀私有属性为本项目内部状态惯例（无对应公有属性），豁免 backing property 命名规则
ktlint_standard_backing-property-naming = disabled
# Compose 代码惯用通配导入（foundation.layout.* / runtime.* 等），豁免通配导入规则
ktlint_standard_no-wildcard-imports = disabled

# UniFFI 生成物（nativecore/build/generated/uniffi 与 uniffi-kmp）：文件名、类名与缩进均由生成器模板决定，
# 且每次构建都会被覆盖重写，故整目录豁免 ktlint。
[**/generated/uniffi/**/*.{kt,kts}]
ktlint = disabled

[**/generated/uniffi-kmp/**/*.{kt,kts}]
ktlint = disabled

# KSP 生成物（build/generated/ksp）：Room 生成的 *_Impl 由注解处理器模板产出，
# 格式不可控且每次构建都会重写，整目录豁免 ktlint。
[**/generated/ksp/**/*.{kt,kts}]
ktlint = disabled
