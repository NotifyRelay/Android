root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = off
ktlint_code_style = ktlint_official
# @Composable 函数按 Jetpack Compose 惯例首字母大写，豁免函数命名规则
ktlint_standard_function-naming = disabled
# 下划线前缀私有属性为本项目内部状态惯例（无对应公有属性），豁免 backing property 命名规则
ktlint_standard_backing-property-naming = disabled
# Compose 代码惯用通配导入（foundation.layout.* / runtime.* 等），豁免通配导入规则
ktlint_standard_no-wildcard-imports = disabled

# 构建生成目录整体豁免：build/generated 下的一切内容（UniFFI 绑定、KSP/Room、
# Compose 资源、以及后续新增的任何生成器）均由工具模板产出，格式不可控且每次
# 构建都会重写。此处按目录整棵排除，避免每接入一个新生成器就补一条规则。
[**/build/generated/**/*.{kt,kts}]
ktlint = disabled

